{
  "name": "@agilitas/hub-sdk",
  "version": "1.0.0",
  "description": "Plug a Next.js app into apps.agilitasenergysolutions.com: shared sign-in, access checks, All dashboards button.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@supabase/ssr": ">=0.5.0",
    "@supabase/supabase-js": ">=2.40.0",
    "next": ">=14.2.0",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamanonym0us/iamanonym0us-agilitas-hub-sdk.git"
  }
}
